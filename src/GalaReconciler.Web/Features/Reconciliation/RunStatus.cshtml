@model Run
@{
    var failed = Model.Status == RunStatus.Failed;
    ViewData["Title"] = failed ? "Comparison failed" : "Comparing";
}

<div class="mx-auto max-w-2xl space-y-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <dl class="grid gap-x-6 gap-y-1.5 text-sm sm:grid-cols-[auto_1fr]">
            <dt class="text-slate-500">Source</dt>
            <dd class="min-w-0 truncate font-medium text-slate-800" title="@Model.SourceFileName">@Model.SourceFileName</dd>
            <dt class="text-slate-500">Processed</dt>
            <dd class="min-w-0 truncate font-medium text-slate-800" title="@Model.ProcessedFileName">@Model.ProcessedFileName</dd>
            <dt class="text-slate-500">Uploaded</dt>
            <dd class="text-slate-700">@RunsViewModel.LocalTime(Model.CreatedAtUtc)</dd>
        </dl>
    </div>

    @if (failed)
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 p-6" role="alert">
            <div class="flex gap-3">
                <svg class="mt-0.5 size-5 shrink-0 text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" /><path d="M12 8v4" /><path d="M12 16h.01" />
                </svg>
                <div class="min-w-0">
                    <h1 class="font-semibold text-rose-800">@(Model.ErrorTitle ?? "The comparison failed")</h1>
                    <p class="mt-1 text-sm text-rose-700">@Model.ErrorMessage</p>
                    @if (Model.MissingHeaders.Count > 0)
                    {
                        <div class="mt-3 flex flex-wrap gap-1.5">
                            @foreach (var header in Model.MissingHeaders)
                            {
                                <code class="rounded-md bg-white px-2 py-0.5 font-mono text-xs text-rose-700 ring-1 ring-rose-200">@header</code>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center">
            <form asp-action="DeleteRun" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this run?');">
                <button type="submit" class="text-sm font-medium text-slate-500 hover:text-rose-700">Delete run</button>
            </form>
            <a asp-action="ListRuns" class="text-sm font-medium text-slate-600 hover:text-slate-900 sm:ml-auto">All runs</a>
            <a asp-action="Index"
               class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                Try again
            </a>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-slate-200 bg-white px-6 py-14 text-center shadow-sm" aria-live="polite">
            <svg class="mx-auto size-10 animate-spin text-indigo-600" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" />
                <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v3a5 5 0 0 0-5 5H4z" />
            </svg>
            <h1 class="mt-5 text-lg font-semibold text-slate-900" data-status-label>
                @(Model.Status == RunStatus.Processing ? "Comparing the files…" : "Waiting for the files to be compared…")
            </h1>
            <p class="mx-auto mt-2 max-w-md text-sm text-slate-500">
                This page updates by itself when the results are ready. You can also leave and find this comparison under
                <a asp-action="ListRuns" class="font-medium text-indigo-600 hover:text-indigo-500">Runs</a>.
            </p>
        </div>
    }
</div>

@section Scripts {
    @if (!failed)
    {
        <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
        <script>
            (() => {
                const runId = '@Model.Id';
                const label = document.querySelector('[data-status-label]');
                const isFinished = (status) => status === 'Completed' || status === 'Failed';
                let reloading = false;
                const reload = () => { if (!reloading) { reloading = true; location.reload(); } };

                function show(status) {
                    if (isFinished(status)) reload();
                    else if (status === 'Processing') label.textContent = 'Comparing the files…';
                }

                const connection = new signalR.HubConnectionBuilder()
                    .withUrl('@Url.Content("~" + GalaReconciler.Web.Features.Reconciliation.Realtime.ComparisonHub.Path)')
                    .withAutomaticReconnect()
                    .build();

                connection.on('RunStatusChanged', (id, status) => { if (id === runId) show(status); });

                // WatchRun returns the current status too, so a run that finished before we connected isn't missed.
                const watch = () => connection.invoke('WatchRun', runId).then(show);
                connection.onreconnected(watch);

                // If live updates aren't available, fall back to reloading the page every few seconds.
                connection.start().then(watch).catch(() => setTimeout(reload, 3000));
                connection.onclose(() => setTimeout(reload, 3000));
            })();
        </script>
    }
}
