<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Users get GalaReconciler.exe. -->
    <AssemblyName>GalaReconciler</AssemblyName>
    <RootNamespace>GalaReconciler.Cli</RootNamespace>
    <Product>GALA Reconciler</Product>
    <Version>1.0.0</Version>
    <!-- For the generated P/Invoke that detects a double-clicked console window (Program.OwnsConsoleWindow). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GalaReconciler.Core\GalaReconciler.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped next to the exe. -->
    <None Include="HOW TO USE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
