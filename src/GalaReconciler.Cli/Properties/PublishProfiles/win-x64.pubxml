<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained GalaReconciler.exe for Windows (no .NET install needed):
    dotnet publish src/GalaReconciler.Cli -p:PublishProfile=win-x64
  Output: artifacts/win-x64/
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- No .pdb files from referenced projects next to the exe either. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
